# ──────────────────────────────────────────────
# RAGaaS Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── Application ──
APP_NAME=ragaas
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── API Server ──
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1                # Uvicorn workers (increase in prod)

# ── PostgreSQL ──
DATABASE_URL=postgresql+asyncpg://ragaas:ragaas_secret@localhost:5432/ragaas
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Qdrant ──
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=              # Leave empty for local dev

# ── OpenAI (Embeddings) ──
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── LLM (Query answering) ──
LLM_PROVIDER=openai          # openai | anthropic | mock
OPENAI_LLM_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Mock LLM (for testing without API costs) ──
MOCK_LLM=false               # Set to true to use mock responses

# ── S3 / Object Storage ──
STORAGE_BACKEND=local        # local | s3
S3_BUCKET_NAME=ragaas-files
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCAL_STORAGE_PATH=./storage  # Used when STORAGE_BACKEND=local

# ── Celery ──
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security ──
API_KEY_PREFIX=rgs_live_     # Prefix for generated API keys
CORS_ORIGINS=["http://localhost:3000"]

# ── Stripe (deferred — not used yet) ──
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
